# Copy to .env, chmod 600, and replace the placeholders. This file is a
# template only; do not put real values here.

# Required browser settings. These fail closed and must be set by the operator.
PORTFOLIO_PUBLIC_ORIGIN=https://REPLACE_WITH_EXACT_PUBLIC_ORIGIN
PORTFOLIO_AUTH_USERNAME=REPLACE_WITH_LOGIN_USERNAME
PORTFOLIO_AUTH_PASSWORD_HASH='REPLACE_WITH_BCRYPT_PASSWORD_HASH'
PORTFOLIO_SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_BASE64_SECRET

# Compose creates and manages the application data volume automatically.
# The service uses the fixed least-privilege identity 65532:65532.
PORTFOLIO_HOST_IP=127.0.0.1
PORTFOLIO_HOST_PORT=8080
PORTFOLIO_REPORTING_CURRENCY=MYR

# Optional bootstrap defaults for the in-process scheduled market refresh.
# Leave CRON blank to disable the deployment default; UI-saved portfolio
# settings win over these values, including a saved disabled setting.
# Daily example: 0 5 * * * at 05:00 in Singapore.
PORTFOLIO_MARKET_REFRESH_CRON=
PORTFOLIO_MARKET_REFRESH_TIMEZONE=Asia/Singapore
PORTFOLIO_MARKET_REFRESH_PORTFOLIO_ID=portfolio-default
# Blank reads the portfolio's current reporting currency at execution time.
PORTFOLIO_MARKET_REFRESH_REPORTING_CURRENCY=

# Optional least-privilege external Hermes machine identity. This is an
# external bearer identity, not an embedded runtime. Leave the three values
# blank and all runtime grants false to disable it. Market-data setup,
# discovery, mapping, and refresh require the exact configured principal and
# portfolio. Market-data setup, discovery, and mapping additionally require the exact
# configured principal and portfolio, PORTFOLIO_MACHINE_PORTFOLIO_READ=true,
# PORTFOLIO_MACHINE_HOLDINGS_WRITE=true, and the persisted portfolio-read plus
# holdings-write grant for that same principal and portfolio. Refresh-only
# Hermes calls use the same exact-portfolio portfolio-read authority and do not
# receive holdings-write authority. Review writes additionally require
# PORTFOLIO_MACHINE_REVIEWS_WRITE=true.
# Stable non-secret audit identity, for example hermes-reviewer.
PORTFOLIO_MACHINE_PRINCIPAL_ID=
# Bound portfolio; the current default is portfolio-default.
PORTFOLIO_MACHINE_PORTFOLIO_ID=
# Independent random printable secret; never commit it.
PORTFOLIO_MACHINE_BEARER_SECRET=
# Scoped snapshot/context/read permission.
PORTFOLIO_MACHINE_PORTFOLIO_READ=false
# Immutable advisory review submission permission.
PORTFOLIO_MACHINE_REVIEWS_WRITE=false
# Independent holding create/archive permission; never implied by reviews.
PORTFOLIO_MACHINE_HOLDINGS_WRITE=false


# Optional market-provider credentials. These are independent of the optional
# machine identity; leave each blank when its provider is unused.
# They are injected at runtime and are never copied into the image or SQLite.
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
OPEN_EXCHANGE_RATES_APP_ID=
