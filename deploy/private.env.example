# Copy to .env and chmod 600. Set the required values below.
# Leave the optional machine/provider values blank unless enabling that feature.
# This file is a template only. Do not put real values here.
PORTFOLIO_PUBLIC_ORIGIN=https://REPLACE_WITH_EXACT_PUBLIC_ORIGIN
PORTFOLIO_AUTH_USERNAME=REPLACE_WITH_LOGIN_USERNAME
PORTFOLIO_AUTH_PASSWORD_HASH=REPLACE_WITH_BCRYPT_PASSWORD_HASH
PORTFOLIO_SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_BASE64_SECRET

# Compose interpolation settings. Set PORTFOLIO_DATA_DIR to an operator-owned
# directory; the other defaults are safe to keep unless they conflict locally.
PORTFOLIO_DASHBOARD_IMAGE=
PORTFOLIO_DATA_DIR=
PORTFOLIO_CONTAINER_UID=65532
PORTFOLIO_CONTAINER_GID=65532
PORTFOLIO_HOST_PORT=8080
PORTFOLIO_REPORTING_CURRENCY=MYR

# Optional scoped machine reader. Leave all four unset/false to disable it.
PORTFOLIO_MACHINE_PRINCIPAL_ID=
PORTFOLIO_MACHINE_PORTFOLIO_ID=
PORTFOLIO_MACHINE_BEARER_SECRET=
PORTFOLIO_MACHINE_PORTFOLIO_READ=false
PORTFOLIO_MACHINE_REVIEWS_WRITE=false

# Optional provider credentials. Leave blank when the corresponding provider is unused.
# They are injected at runtime and are never copied into the image or SQLite.
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
OPEN_EXCHANGE_RATES_APP_ID=
